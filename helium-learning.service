[Unit]
Description=Helium Learning Go Proxy (ToolsMandi)
After=network.target mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/1clkaccess.store/hellearn
ExecStart=/www/wwwroot/1clkaccess.store/hellearn/helium-learning-go-proxy
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=helium-learning
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
